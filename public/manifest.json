{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "short_name": "Bookmarks",
  "version": "0.2.0",
  "description": "A visual bookmark manager that makes you want to look at your bookmarks.",
  "minimum_chrome_version": "116",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to Bookmark Manager",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save this page"
    }
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "bookmarks",
    "contextMenus",
    "tabs",
    "favicon",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
